{
  "name": "web-forager-browser",
  "version": "1.1.0",
  "description": "Browser mode of web-forager: drive a real browser through a bridge, follow read-only playbooks, and record what it sees in the web-forager workspace shape.",
  "main": "run.js",
  "bin": {
    "web-forager-browser": "run.js",
    "web-forager-browser-mcp": "mcp_server.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:live": "node tests/live-smoke.js",
    "mcp": "node mcp_server.js"
  },
  "files": [
    "run.js",
    "mcp_server.js",
    "lib/",
    "playbooks/",
    "bridges/",
    "tests/"
  ],
  "keywords": [
    "browser",
    "bilibili",
    "zhihu",
    "xiaohongshu",
    "danmaku",
    "mcp",
    "session"
  ],
  "author": {
    "name": "Jiaming Shi"
  },
  "license": "MIT"
}
