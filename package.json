    "browser/bridges/",
    "scripts/",
    "commands/",
    "docs/",
    "SKILL.md",
    "AGENTS.md",
    "manifest.json",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "THIRD_PARTY_LICENSES.txt",
    "LICENSE"
